{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "pnpm install",
	"buildCommand": "pnpm run build:dependencies && pnpm --filter @kaneo/web build",
	"outputDirectory": "apps/web/dist",
	"framework": "vite",
	"rewrites": [
		{
			"source": "/api/:match*",
			"destination": "https://kaneo-api-oweb.fly.dev/api/:match*"
		},
		{ "source": "/(.*)", "destination": "/index.html" }
	]
}
